---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carousel from '../../components/Carousel.astro';
import DocumentaryCarousel from '../../components/DocumentaryCarousel.astro';
import GraphicCategoryCards from '../../components/GraphicCategoryCards.astro';
import {documentaries} from '../../data/documentaries';
import {photography} from '../../data/photography';
import {reels} from '../../data/reels';
import {graphicDesign} from '../../data/graphicDesign';
---
<BaseLayout title="WORK"><header data-reveal><h1 class="heading" data-reveal-item>WORK</h1><p data-reveal-item>A selection of visual documentation and creative work across documentary films, photography, design and reels.</p></header><section id="documentary"><div class="cat-intro" data-reveal><h2 data-reveal-item>Documentary</h2><p class="cat-desc" data-reveal-item>Documentary films exploring communities, environments, and everyday life.</p></div><DocumentaryCarousel items={documentaries.map(d=>({title:d.title,subtitle:d.subtitle,image:d.hero.poster,poster:d.hero.video?d.hero.poster:undefined,video:d.hero.video||undefined,href:`/work/documentary/${d.slug}`}))}/></section><section id="photography"><div class="cat-intro" data-reveal><h2 data-reveal-item>Photography</h2><p class="cat-desc" data-reveal-item>Photographic work documenting people, places, culture, and the everyday.</p></div><Carousel photo items={photography.map(p=>({title:p.title,image:p.image,caption:p.caption,href:`/work/photography/${p.slug}`}))}/></section><section id="graphic-design"><div class="cat-intro" data-reveal><h2 data-reveal-item>Desain Grafis</h2><p class="cat-desc" data-reveal-item>Visual identities, posters, and social media works.</p></div><GraphicCategoryCards cards={graphicDesign.categoryCards} thumbs={{logos:{src:graphicDesign.logos[0].image,alt:graphicDesign.logos[0].title},posters:{src:graphicDesign.posters[0].image,alt:graphicDesign.posters[0].title},socialMedia:{src:graphicDesign.socialMedia[0].image,alt:graphicDesign.socialMedia[0].title}}}/></section><section id="reels"><div class="cat-intro" data-reveal><h2 data-reveal-item>Reels</h2><p class="cat-desc" data-reveal-item>Short-form visual stories from people, places, and events.</p></div><div class="work-reels"><Carousel portrait reels items={reels.map(r=>({title:r.title,image:r.thumbnail,alt:r.caption,source:r.source}))}/></div></section></BaseLayout>
<style>.work-reels{width:100%;max-width:900px;margin-inline:auto;min-width:0}.work-reels :global(.track){overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-ms-overflow-style:none}.work-reels :global(.track::-webkit-scrollbar){display:none;width:0;height:0}header{text-align:center;margin-top:30px}header p{max-width:530px;margin:30px auto;line-height:1.4}header .heading{font-size:clamp(3rem,14.8vw,11.5rem)}section{padding:55px 0}h2{font-size:38px;letter-spacing:-.04em}
/* CATEGORY INTRO — komposisi editorial: judul kiri, deskripsi kanan, satu baris.
   Hanya wadah komposisi; tidak ada card/background/border/divider (§08, §18).
   h2 TIDAK diperbesar — 38px tetap, jelas di bawah .heading WORK (§03, §17). */
.cat-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(16px,4vw,48px);align-items:center;margin-bottom:clamp(28px,4vw,44px)}
.cat-intro h2{margin:0}
/* Deskripsi: teks pendukung — regular, lebih kecil dari judul, ringan (§05). */
.cat-desc{margin:0;max-width:44ch;font-size:15px;font-weight:400;line-height:1.5;letter-spacing:normal;opacity:.62;justify-self:end}
@media(max-width:820px){
  /* Tablet/mobile: alihkan ke vertical flow — judul, deskripsi, konten (§16). */
  .cat-intro{grid-template-columns:1fr;gap:10px}
  .cat-desc{justify-self:start;max-width:52ch}
}.back-wrap{display:flex;justify-content:center;margin:55px 0 5px}.back-link{display:inline-flex;align-items:center;padding:10px 18px;border:1px solid transparent;border-radius:99px;font-size:13px;transition:background .25s var(--ease-out-editorial),border-color .25s var(--ease-out-editorial)}.back-link:hover,.back-link:focus-visible,.back-link:active{background:rgba(255,255,255,.65);border-color:rgba(17,17,16,.16)}</style>
