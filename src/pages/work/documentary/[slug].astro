---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GlassNav from '../../../components/GlassNav.astro';
import {documentaries} from '../../../data/documentaries';

export function getStaticPaths(){return documentaries.map((item,index)=>({params:{slug:item.slug},props:{item,index}}));}
const {item,index}=Astro.props;
// §9 category-aware + §11 cyclic, mengikuti urutan data existing (§10).
const previous=documentaries[(index-1+documentaries.length)%documentaries.length];
const next=documentaries[(index+1)%documentaries.length];
// §8 Back deterministik ke list Documentary.
const backHref='/work#documentary';
---
<BaseLayout title={item.title}><article class="detail"><div class="hero"><img src={item.hero.poster} alt={item.title}/></div><div class="project-info" data-reveal><div class="col-left"><h1 class="project-title" data-reveal-item>{item.title}</h1><p class="project-desc" data-reveal-item>{item.description}</p></div><div class="col-right" data-reveal-item><dl class="meta"><div class="meta-group"><dt>Location</dt><dd>{item.location}</dd></div><div class="meta-group"><dt>Role</dt><dd>{item.roles}</dd></div><div class="meta-group"><dt>Kredit Produksi</dt><dd><ul class="credits">{item.credits.map(c=><li>{c.role} — {c.name}</li>)}</ul></dd></div></dl></div></div><div class="gallery" data-reveal-media>{item.gallery.map(p=><img src={p.src} alt={p.alt}/>)}</div></article><div class="detail-nav-wrap"><GlassNav
  backHref={backHref}
  prevHref={`/work/documentary/${previous.slug}`}
  nextHref={`/work/documentary/${next.slug}`}
  backLabel="Back to Documentary"
/></div></BaseLayout>
<style>.detail{max-width:1100px;margin:auto}
/* Nav standard: dibungkus agar tepinya sejajar dengan batas container konten
   (.detail), bukan melebar ke lebar main.page. */
.detail-nav-wrap{max-width:1100px;margin:auto}.hero{aspect-ratio:16/8;margin:35px 0;border-radius:14px;overflow:hidden;background:#d8d4ca}.hero img{width:100%;height:100%;object-fit:cover}/* ===== PROJECT INFORMATION — dua kolom (judul+deskripsi | metadata) =====
   Satu container, CSS Grid. Tanpa absolute positioning (§4/§10).
   Kolom kiri = Level 1 (judul) + Level 3 (deskripsi).
   Kolom kanan = Level 2 (label) + Level 3 (value). */
.project-info{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:clamp(32px,5vw,72px);align-items:start;margin:clamp(36px,5vw,60px) 0 clamp(40px,6vw,72px)}
.col-left{min-width:0}
.col-right{min-width:0}
/* LEVEL 1 — judul project: dominan, bold, compact, TIDAK oversized (§5/§12). */
.project-title{font-size:clamp(1.75rem,3.4vw,2.75rem);font-weight:700;letter-spacing:-.03em;line-height:1.08;margin:0 0 clamp(14px,1.6vw,20px)}
/* LEVEL 3 — deskripsi: regular, lebih kecil dari judul, lebar terkendali (§6). */
.project-desc{font-size:15px;font-weight:400;line-height:1.65;max-width:46ch;margin:0;opacity:.75}
/* LEVEL 2 — label metadata lebih tegas; value regular (§8/§12). */
.meta{display:grid;gap:clamp(18px,2.2vw,26px);margin:0}
.meta-group{display:grid;gap:5px}
.meta dt{font-size:13px;font-weight:600;letter-spacing:.01em;opacity:.95}
.meta dd{margin:0;font-size:15px;font-weight:400;line-height:1.6;opacity:.75}
.credits{list-style:none;margin:0;padding:0;display:grid;gap:2px}
/* ===== GALLERY — arsip visual konsisten 3:2, 3 kolom desktop (§14/§15). ===== */
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.gallery img{width:100%;height:100%;aspect-ratio:3/2;object-fit:cover;border-radius:10px}
/* ===== MOBILE — vertical flow, gallery tetap 3:2 (§18/§19). ===== */
@media(max-width:820px){
  .project-info{grid-template-columns:1fr;gap:clamp(28px,5vw,40px)}
}
@media(max-width:700px){
  .gallery{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:480px){
  .gallery{grid-template-columns:1fr}
}</style>
