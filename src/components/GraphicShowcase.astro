---
interface Item { title: string; image: string; description: string; category: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---

<section class="graphic-showcase" data-graphic-showcase>
  <div class="track" data-track>
    {items.map((item, i) => (
      <article class="slide" data-slide data-category={item.category}>
        <button
          type="button"
          class="media lightbox-trigger"
          data-lightbox
          data-title={item.title}
          data-description={item.description}
          data-full={item.image}
          aria-label={`Lihat ${item.title} ukuran penuh`}
          aria-haspopup="dialog"
          draggable="false"
        >
          <img src={item.image} alt={item.title} draggable="false" loading={i < 2 ? 'eager' : 'lazy'} />
        </button>
        <p class="caption">{item.title}</p>
      </article>
    ))}
  </div>

  <div class="controls">
    <div class="dots" role="tablist" aria-label="Pilih karya">
      {items.map((item, i) => (
        <button
          type="button"
          class="dot"
          role="tab"
          data-dot
          data-index={i}
          aria-label={`${item.title} (${item.category})`}
          aria-selected={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
    <p class="category-indicator" data-category-indicator aria-live="polite">{items[0]?.category ?? ''}</p>
  </div>
</section>

<style>
  .graphic-showcase{position:relative}
  /* padding 20% kiri/kanan → content box = 60% lebar luar. Slide 100% content
     box = 60% lebar luar, dengan peek satu slide di tiap sisi. */
  .track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 20%;touch-action:pan-x pan-y;scroll-padding-inline:0}
  .track::-webkit-scrollbar{display:none}
  .slide{flex:0 0 100%;scroll-snap-align:center;min-width:0}
  .media{display:block;width:100%;aspect-ratio:4/5;padding:0;border:0;background:#ddd;cursor:pointer;overflow:hidden;user-select:none;-webkit-user-drag:none}

<script>
  function setupGraphicShowcase(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const indicator = root.querySelector<HTMLElement>('[data-category-indicator]');
    if (!slides.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const setActive = (index: number) => {
      dots.forEach((dot, i) => dot.setAttribute('aria-selected', i === index ? 'true' : 'false'));
      if (indicator) indicator.textContent = slides[index]?.dataset.category ?? '';
    };

    const scrollToIndex = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const slide = slides[index];
      if (!slide) return;
      const left = slide.offsetLeft - (track.clientWidth - slide.clientWidth) / 2;
      track.scrollTo({ left, behavior: reduced.matches ? 'auto' : behavior });
    };

    // Slide aktif = yang paling dekat ke tengah viewport track.
    const updateActiveFromScroll = () => {
      const center = track.scrollLeft + track.clientWidth / 2;
      let best = 0, bestDist = Infinity;
      slides.forEach((slide, i) => {
        const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
        const dist = Math.abs(slideCenter - center);
        if (dist < bestDist) { bestDist = dist; best = i; }
      });
      setActive(best);
    };

    dots.forEach(dot => dot.addEventListener('click', () => {
      const index = Number(dot.dataset.index);
      if (!Number.isNaN(index)) scrollToIndex(index);
    }));

    let raf = 0;
    track.addEventListener('scroll', () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; updateActiveFromScroll(); });
    }, { passive: true });

    // Keyboard: panah kiri/kanan memindah slide.
    track.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      const current = dots.findIndex(dot => dot.getAttribute('aria-selected') === 'true');
      const next = event.key === 'ArrowLeft' ? Math.max(0, current - 1) : Math.min(slides.length - 1, current + 1);
      if (next !== current) { event.preventDefault(); scrollToIndex(next); setActive(next); }
    });

    // Drag-vs-click: drag mouse tidak boleh memicu Lightbox.
    let dragging = false, startX = 0, startScroll = 0, moved = false;
    const DRAG_THRESHOLD = 6;

    track.addEventListener('pointerdown', (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return; // touch sudah native
      dragging = true; moved = false;
      startX = event.clientX; startScroll = track.scrollLeft;
    });
    track.addEventListener('pointermove', (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      if (!moved && Math.abs(dx) > DRAG_THRESHOLD) { moved = true; track.setPointerCapture(event.pointerId); }
      if (!moved) return;
      track.scrollLeft = startScroll - dx;
      event.preventDefault();
    });
    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    // Suppress klik bila pointer baru saja melakukan drag.
    track.addEventListener('click', (event) => {
      if (moved) { event.preventDefault(); event.stopPropagation(); moved = false; }
    }, true);

    setActive(0);
    scrollToIndex(0, 'auto');
  }

  function initGraphicShowcases() {
    document.querySelectorAll<HTMLElement>('[data-graphic-showcase]').forEach(setupGraphicShowcase);
  }
  initGraphicShowcases();
  document.addEventListener('astro:page-load', initGraphicShowcases);
</script>

  .media img{display:block;width:100%;height:100%;object-fit:cover;pointer-events:none;user-select:none;-webkit-user-drag:none}
  .caption{text-align:center;margin:14px auto 0;max-width:460px;line-height:1.4}
  .controls{margin-top:22px;text-align:center}
  .dots{display:flex;justify-content:center;gap:10px}
  .dot{width:9px;height:9px;padding:0;border-radius:99px;border:1px solid rgba(17,17,16,.35);background:transparent;cursor:pointer;transition:background .25s var(--ease-out-editorial),border-color .25s var(--ease-out-editorial)}
  .dot[aria-selected='true']{background:var(--ink);border-color:var(--ink)}
  .dot:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
  /* Indikator kategori: teks saja, BUKAN navigasi/filter. */
  .category-indicator{margin:12px 0 0;font-size:13px;letter-spacing:.02em;text-transform:none;opacity:.7}
  @media(max-width:600px){
    /* padding 12% kiri/kanan → content box = 76% lebar luar. */
    .track{padding:0 12%;gap:12px}
  }
  @media(prefers-reduced-motion:reduce){
    .track{scroll-behavior:auto}
    .dot{transition:none}
  }
</style>
