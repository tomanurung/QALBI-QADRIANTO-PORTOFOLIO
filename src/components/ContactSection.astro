---
// Section Contact (BODY saja, tanpa layout/h1 pembungkus halaman).
// Sumber tunggal: dipakai oleh /contact dan pengalaman kontinu di /.
import {site,whatsappUrl} from '../data/site';
const actions=[{label:'EMAIL',value:site.contacts.email,href:`mailto:${site.contacts.email}`,caption:'Send direct email',email:true},{label:'WHATSAPP & PHONE',value:site.contacts.whatsapp,href:whatsappUrl(site.contacts.whatsapp),caption:'Chat on WhatsApp'},{label:'INSTAGRAM',value:site.contacts.instagram,href:site.contacts.instagramUrl,caption:'Direct Message'},{label:'LINKED IN',value:site.contacts.linkedin,href:site.contacts.linkedinUrl,caption:'Professional Network'}];
---

<section class="card contact" data-contact-section><div><h2>Get in touch</h2><p>Terbuka untuk kolaborasi pembuatan film dokumenter, riset partisipatif lingkungan, pemetaan wilayah kelola rakyat, maupun diskusi advokasi keadilan sosial.</p><div class="actions">{actions.map(a=>a.href?<a href={a.href} target="_blank" rel="noopener noreferrer" class={a.email?'email-link':undefined} data-email={a.email?site.contacts.email:undefined}><strong>{a.label} ↗</strong><span>{a.value}</span><small>{a.caption}</small></a>:<div aria-disabled="true"><strong>{a.label}</strong><span>{a.value}</span><small>URL belum tersedia</small></div>)}</div></div><aside><h3>BASED IN</h3><p>{site.location}</p><h3>FIELD AVAILABILITY</h3><p>Bersedia untuk penugasan lapangan dokumenter dan advokasi seluruh wilayah Indonesia</p><h3>CURRICULUM VITAE</h3>{site.cv.url?<a href={site.cv.url} target="_blank" rel="noopener noreferrer">View / Download CV ↗</a>:<button disabled>CV belum tersedia</button>}</aside></section>

<script>
  // Buka Gmail compose di browser (tab baru); mailto: tetap jadi fallback.
  // Dibatasi ke section ini agar tidak bertumpuk dengan handler Footer.
  document.querySelectorAll<HTMLElement>('[data-contact-section]').forEach((root) => {
    root.querySelectorAll<HTMLAnchorElement>('a.email-link[data-email]').forEach((a) => {
      if (a.dataset.emailBound) return;
      a.dataset.emailBound = 'true';
      a.addEventListener('click', (e) => {
        const email = a.dataset.email;
        if (!email) return; // biarkan mailto: bawaan berjalan sebagai fallback
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}`;
        const w = window.open(url, '_blank', 'noopener,noreferrer');
        if (!w) window.location.href = a.href; // fallback bila popup diblokir
      });
    });
  });
</script>
<style>
  .contact{display:grid;grid-template-columns:1.5fr 1fr;gap:45px;padding:45px}
  .contact h2{font-size:32px;margin:0}
  .contact p{line-height:1.6}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:30px}
  .actions>a,.actions>div{background:var(--paper);padding:20px;border-radius:12px;overflow-wrap:anywhere;transition:transform .3s var(--ease-out-editorial)}
  .actions span,.actions small{display:block;margin-top:12px}
  .actions strong{font-size:12px}
  aside{border-left:1px solid;padding-left:40px}
  aside h3{font-size:12px;margin-top:30px}
  button:disabled{opacity:.55}
  @media(hover:hover){.actions a:hover{transform:scale(1.015)}}
  @media(max-width:768px){.contact,.actions{grid-template-columns:1fr}.contact{padding:24px}aside{border-left:0;border-top:1px solid;padding:20px 0 0}}
</style>
