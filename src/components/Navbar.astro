---
// FINAL LOCK: Navbar disetujui pengguna. Jangan ubah tampilan/perilaku tanpa instruksi eksplisit; lihat NAVBAR-FINAL.md di root proyek.
import { site, activeNav } from '../data/site';
---
<nav aria-label="Main navigation" class="glass" id="main-nav">
{site.nav.map(item => <a href={item.href} aria-current={activeNav(Astro.url.pathname,item.href) ? 'page' : undefined}>{item.label}</a>)}
</nav>
<style>nav{position:fixed;top:24px;left:50%;transform:translateX(-50%);z-index:50;display:flex;padding:6px;border-radius:99px;white-space:nowrap;background:rgba(255,255,255,.5);backdrop-filter:blur(16px) saturate(200%);-webkit-backdrop-filter:blur(16px) saturate(200%);border:1px solid rgba(255,255,255,.78);box-shadow:0 12px 34px rgba(17,17,16,.08),inset 0 1px 0 rgba(255,255,255,.75);transition:transform .4s var(--ease-out-editorial),opacity .4s,box-shadow .3s}nav.scrolled{background:rgba(255,255,255,.5);backdrop-filter:blur(16px) saturate(200%);-webkit-backdrop-filter:blur(16px) saturate(200%);box-shadow:0 12px 34px rgba(17,17,16,.12),inset 0 1px 0 rgba(255,255,255,.9),inset 0 -1px 0 rgba(255,255,255,.3)}nav::before{content:"";position:absolute;inset:1px;border-radius:inherit;pointer-events:none;background:linear-gradient(180deg,rgba(255,255,255,.35),rgba(255,255,255,0));opacity:.7}a{position:relative;padding:12px 20px;font-size:12px;font-weight:700;border-radius:99px}a[aria-current]{background:rgba(210,209,205,.68);box-shadow:inset 0 1px 0 rgba(255,255,255,.5)}nav.hidden{transform:translate(-50%,-150%);opacity:0;pointer-events:none}@media(max-width:500px){a{padding:12px 11px;font-size:10px}}</style>
<script>
let previous = window.scrollY;
window.addEventListener('scroll',()=>{const y=window.scrollY;const nav=document.querySelector('#main-nav');nav?.classList.toggle('scrolled',y>8);nav?.classList.toggle('hidden',y>80&&y>previous);previous=y;},{passive:true});
document.addEventListener('astro:page-load',()=>{previous=window.scrollY;document.querySelector('#main-nav')?.classList.toggle('scrolled',previous>8);});
</script>
